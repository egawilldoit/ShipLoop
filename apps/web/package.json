{
  "name": "@shiploop/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server/main.ts",
    "start": "node src/server/main.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test 'src/**/*.test.ts'",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "8.3.0",
    "@shiploop/adapters": "workspace:*",
    "@shiploop/controller": "workspace:*",
    "@shiploop/domain": "workspace:*",
    "@shiploop/storage": "workspace:*",
    "@shiploop/verification": "workspace:*",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "7.3.6"
  }
}
